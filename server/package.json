  "license": "Apache-2.0",
  "type": "module",
    "scripts": {
    "dev": "tsx watch src/core/main.ts",
    "build": "pnpm --filter @vyomdesk/shared build && tsc -p tsconfig.json",
    "start": "node dist/core/main.js",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/static": "7",
    "@fastify/websocket": "^10.0.1",
    "@vyomdesk/shared": "workspace:*",
    "argon2": "^0.41.1",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "jose": "^5.9.3",
    "knex": "^3.1.0",
    "nanoid": "^5.0.7",
    "nodemailer": "^10.0.10",
    "pg": "^8.12.0",
    "pino": "^9.4.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}

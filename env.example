# VyomDesk Server Configuration
# Copy to server/.env (or export as env vars) and adjust.
# All values optional — sane defaults for local dev.

# --- Core ---
NODE_ENV=development
PORT=4430
HOST=0.0.0.0

# Public URL agents/browsers use to reach this server (no trailing slash)
# Public cloud example: https://vyomdesk.online
VYOM_PUBLIC_URL=http://localhost:4430

# --- Database ---
# SQLite (default, zero-config): file path
VYOM_DB_CLIENT=sqlite3
VYOM_DB_FILENAME=./data/vyomdesk.sqlite
# PostgreSQL (scale): set client to pg and fill below
# VYOM_DB_CLIENT=pg
# VYOM_DB_URL=postgresql://vyom:vyom@localhost:5432/vyomdesk

# --- Auth ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VYOM_JWT_SECRET=change-me-64-hex-chars
# AES-256 key for encrypting secrets at rest (TOTP, link keys)
VYOM_ENCRYPTION_KEY=change-me-64-hex-chars

# Access token lifetime (seconds)
VYOM_JWT_TTL=86400

# --- Agent hub ---
# Agent ping/heartbeat interval (seconds)
VYOM_AGENT_PING_INTERVAL=30

# --- TLS (production) ---
# Enables HTTPS when set
# VYOM_TLS_CERT=./certs/fullchain.pem
# VYOM_TLS_KEY=./certs/privkey.pem

# --- Branding (optional) ---
VYOM_BRAND_NAME=VyomDesk
